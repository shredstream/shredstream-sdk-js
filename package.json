{
  "name": "shredstream",
  "version": "2.0.0",
  "description": "Solana ShredStream SDK for Node.js — ultra-low latency UDP shred streaming",
  "homepage": "https://shredstream.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shredstream/shredstream-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/shredstream/shredstream-sdk-js/issues"
  },
  "keywords": ["solana", "shredstream", "mev", "hft", "udp", "shred"],
  "author": "ShredStream.com",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "index.js",
    "index.d.ts",
    "shredstream.*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release --cargo-cwd ./napi-rs .",
    "build:debug": "napi build --platform --cargo-cwd ./napi-rs ."
  },
  "napi": {
    "name": "shredstream",
    "triples": {
      "defaults": true,
      "additional": ["aarch64-apple-darwin", "aarch64-unknown-linux-gnu"]
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18",
    "@types/node": "^20",
    "typescript": "^5.4",
    "@solana/web3.js": "^1.91"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.91"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
